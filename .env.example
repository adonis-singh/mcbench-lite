# Add provider keys here or connect them from the Settings screen.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
QWENCLOUD_API_KEY=
# Or sign in once with `npm run cursor:login` instead of a key.
CURSOR_API_KEY=

# The ChatGPT provider signs in with `npm run codex:login`; the server uses that login directly. No API key here.

# Transcript offloading policy (use the same value for compared models)
# MCBENCH_CONTEXT_MAX_BYTES=512000

# Optional overrides
# PORT=3020
# The settings file (default: settings.json in MCBENCH_DATA_DIR, else data/)
# MCBENCH_SETTINGS_FILE=
# Browser y=0 is this Minecraft y
# MCBENCH_MC_Y_OFFSET=64
# The Paper reference server's address and heap (the Paper verifier and scripts, not the app)
# MCBENCH_MC_BIND=127.0.0.1
# MCBENCH_MC_PORT=25599
# MCBENCH_MC_MEMORY=4G
# The JDK (Java 25 or newer) that reads Minecraft's tables and makes the viewer's assets, once; the bake's heap
# MCBENCH_JAVA=java
# MCBENCH_JAVAC=javac
# MCBENCH_BLUEMAP_MEMORY=2G

# Shared builds: the GitHub repository they are published to is set in
# Settings (owner/name, with GitHub Pages on). Publishing runs `git` and `gh`,
# both signed in to an account that can push to it.

# Storage limits in bytes: one chat's attachments,
# images, world chunks and /work; what stays free on the data folder's disk;
# test_build reports kept per chat.
# MCBENCH_CHAT_MAX_BYTES=4294967296
# MCBENCH_DISK_RESERVE_BYTES=2147483648
# MCBENCH_REPORTS_KEPT=100

# Build program heap in MB (shared by all models; Linux data limit = heap + 2 GiB)
# MCBENCH_BUILD_HEAP_MB=2048

# Verification operating budgets (shared by all models)
# MCBENCH_VERIFY_MEMORY=2G
# MCBENCH_VERIFY_MAX_OPERATIONS=1000000
# MCBENCH_VERIFY_MAX_SIMULATION_TICKS=72000
# MCBENCH_VERIFY_MAX_WALL_MS=900000
# MCBENCH_VERIFY_MAX_COLUMNS=16384
# MCBENCH_VERIFY_MAX_TESTS=8
# MCBENCH_VERIFY_MAX_REQUEST_BYTES=8388608
# MCBENCH_VERIFY_MAX_REPORT_BYTES=134217728

# The Claude Code and Codex CLI binaries the harnesses run (default: claude and
# codex on PATH) and their config folders. Only the environment names them.
# MCBENCH_CLAUDE_BINARY=
# MCBENCH_CODEX_BINARY=
# CLAUDE_CONFIG_DIR=
# CODEX_HOME=
