+
+// A wgpu instance whose Vulkan entry points come from the driver library
+// itself (an ICD exporting vkGetInstanceProcAddr, as SwiftShader's does),
+// with the instance extensions wgpu-hal asks of any Vulkan instance.
+#[cfg(not(target_arch = "wasm32"))]
+unsafe fn direct_vulkan(driver: &str) -> Result<wgpu::Instance, String> {
+    use ash::vk;
+    use wgpu::hal::vulkan::Instance as HalInstance;
+    let entry = unsafe { ash::Entry::load_from(driver) }.map_err(|e| format!("{driver}: {e}"))?;
+    let version = unsafe { entry.try_enumerate_instance_version() }.map_err(|e| format!("{driver}: vkEnumerateInstanceVersion: {e}"))?.unwrap_or(vk::API_VERSION_1_0);
+    let flags = wgpu::InstanceFlags::from_build_config().with_env();
+    let extensions = HalInstance::desired_extensions(&entry, version, flags).map_err(|e| format!("{driver}: {e}"))?;
+    let pointers: Vec<*const std::ffi::c_char> = extensions.iter().map(|e| e.as_ptr()).collect();
+    let app = vk::ApplicationInfo::default().application_name(c"mcbench-draw").engine_name(c"wgpu-hal").api_version(if version < vk::API_VERSION_1_1 { vk::API_VERSION_1_0 } else { vk::API_VERSION_1_3 });
+    let raw = unsafe { entry.create_instance(&vk::InstanceCreateInfo::default().application_info(&app).enabled_extension_names(&pointers), None) }.map_err(|e| format!("{driver}: vkCreateInstance: {e}"))?;
+    let hal = unsafe { HalInstance::from_raw(entry, raw, version, 0, None, extensions, flags, Default::default(), false, None) }.map_err(|e| format!("{driver}: {e}"))?;
+    Ok(unsafe { wgpu::Instance::from_hal::<wgpu::hal::api::Vulkan>(hal) })
 }
 
