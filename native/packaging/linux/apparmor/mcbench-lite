# AppArmor profile for mcbench-lite's programs, shipped by its .deb
# (native/packaging/linux/README.md, Ubuntu's AppArmor and bubblewrap).
#
# On Ubuntu 24.04 and later, kernel.apparmor_restrict_unprivileged_userns=1
# moves a program that makes a user namespace without a profile allowing
# `userns` into the profile unprivileged_userns, which denies it every
# capability, so bubblewrap cannot set up the bash sandbox's box and pasta
# cannot set up the networked command's network. This profile gives the two
# programs that start boxes (the app, which runs the boxes' keepers as
# `mcbench-lite sandbox-agent` and the build child under bubblewrap, and the
# static agent) the permission to make user namespaces, and otherwise allows
# everything, as unconfined does. Its rules are those of Ubuntu 26.04's own
# profile for bwrap (/etc/apparmor.d/bwrap-userns-restrict) with the exec
# rules below in place of that profile's move of every child into
# unpriv_bwrap.
#
# /usr/bin/bwrap runs in this profile (ix), because on Ubuntu 26.04 the
# system's bwrap profile would otherwise attach to it and put everything it
# runs in unpriv_bwrap, which denies the networked command's iptables
# CAP_NET_ADMIN inside the box's own network namespace. Every other program
# takes the profile that attaches to it, or this one when none does (pix):
# pasta, the keeper and the box's programs stay here unless a profile of
# their own attaches, and a program with one (a browser the app opens, say)
# gets it, as it would from an unconfined parent.
#
# The package's postinst copies this file to /etc/apparmor.d/mcbench-lite and
# loads it only where the kernel restricts unprivileged user namespaces and
# apparmor_parser is installed; its prerm unloads and removes it.

abi <abi/4.0>,
include <tunables/global>

profile mcbench-lite /usr/lib/mcbench-lite/{mcbench-lite,mcbench-sandbox-agent} flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow /usr/bin/bwrap ix,
  allow pix /**,
}
