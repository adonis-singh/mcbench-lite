[
  { "id": "echo", "command": "echo hello" },
  { "id": "printf-no-newline", "command": "printf 'no newline'" },
  { "id": "stderr", "command": "echo out; echo err >&2" },
  { "id": "interleave", "command": "for i in 1 2 3; do echo o$i; echo e$i >&2; done" },
  { "id": "interleave-python", "command": "python3 -u -c \"import sys\nfor i in range(5):\n    print('out', i); print('err', i, file=sys.stderr)\"" },
  { "id": "subshell-exit", "command": "(exit 7)" },
  { "id": "false", "command": "false" },
  { "id": "true", "command": "true" },
  { "id": "pipefail-code", "command": "set -o pipefail; false | true; echo code=$?; set +o pipefail" },
  { "id": "cd", "command": "cd /tmp; pwd" },
  { "id": "cwd-carried", "command": "pwd" },
  { "id": "cd-back", "command": "cd /work && pwd" },
  { "id": "export", "command": "export FOO=bar" },
  { "id": "env-carried", "command": "echo \"FOO=$FOO\"" },
  { "id": "function", "command": "greet() { echo hi \"$1\"; }; greet a" },
  { "id": "function-carried", "command": "greet b" },
  { "id": "alias-off", "command": "alias ll='ls -l'; type ll 2>&1 | head -1" },
  { "id": "bg-start", "command": "sleep 300 & echo started" },
  { "id": "bg-jobs", "command": "jobs | wc -l" },
  { "id": "bg-kill", "command": "kill %1; wait %1 2>/dev/null; echo killed=$?" },
  { "id": "bg-setsid", "command": "(setsid sleep 300 &); echo detached" },
  { "id": "seq-large", "command": "seq 1 100000" },
  { "id": "long-line", "command": "head -c 30000 /dev/zero | tr '\\0' 'a'" },
  { "id": "utf8-truncated", "command": "python3 -c \"print('é' * 15000)\"" },
  { "id": "emoji-truncated", "command": "python3 -c \"print('x' + '😀' * 6000)\"" },
  { "id": "binary-bytes", "command": "printf '\\x00\\x01\\xff\\xfe\\x80abc\\n'" },
  { "id": "incomplete-utf8", "command": "printf 'ok\\xe2\\x82'" },
  { "id": "all-bytes", "command": "python3 -c \"import sys; sys.stdout.buffer.write(bytes(range(256)))\"" },
  { "id": "many-lines-mixed", "command": "for i in $(seq 1 3000); do echo \"line $i\"; [ $((i % 500)) = 0 ] && echo \"err $i\" >&2; done; true" },
  { "id": "timeout", "command": "echo before; sleep 5", "timeout_ms": 1000 },
  { "id": "after-timeout", "command": "pwd; echo \"FOO=$FOO\"; type greet 2>&1 | head -1; jobs | wc -l" },
  { "id": "timeout-fraction", "command": "sleep 3", "timeout_ms": 1500.5 },
  { "id": "timeout-trap-term", "command": "trap '' TERM; echo trapped; sleep 5", "timeout_ms": 1000 },
  { "id": "timeout-clamped-low", "command": "sleep 2; echo late", "timeout_ms": 5 },
  { "id": "signal-segv", "command": "bash -c 'kill -SEGV $$'; echo code=$?" },
  { "id": "signal-kill", "command": "sh -c 'kill -KILL $$'; echo code=$?" },
  { "id": "exit-shell", "command": "echo leaving; exit 3" },
  { "id": "after-exit", "command": "echo back; pwd" },
  { "id": "set-e", "command": "set -e; false; echo after" },
  { "id": "after-set-e", "command": "echo fresh" },
  { "id": "id", "command": "id" },
  { "id": "whoami", "command": "whoami 2>&1; echo code=$?" },
  { "id": "hostname-length", "command": "hostname | tr -d '\\n' | wc -c; cat /etc/hostname | tr -d '\\n' | wc -c" },
  { "id": "ls-root", "command": "ls /" },
  { "id": "ls-work", "command": "ls /work" },
  { "id": "write-work", "command": "echo data > /work/b.txt; cat b.txt; ls" },
  { "id": "touch-rootfs", "command": "touch /usr/x 2>&1; echo code=$?" },
  { "id": "touch-var-tmp", "command": "touch /var/tmp/x 2>&1; echo code=$?" },
  { "id": "tmp-write", "command": "touch /tmp/x && ls /tmp" },
  { "id": "tmp-size", "command": "df -k /tmp | tail -1 | awk '{print $2}'" },
  { "id": "shm", "command": "df -k /dev/shm | tail -1 | awk '{print $2}'; touch /dev/shm/x && echo shm-ok" },
  { "id": "cgroup-memory", "command": "cat /sys/fs/cgroup/memory.max /sys/fs/cgroup/memory.swap.max" },
  { "id": "cgroup-pids", "command": "cat /sys/fs/cgroup/pids.max" },
  { "id": "cgroup-cpu", "command": "cat /sys/fs/cgroup/cpu.max" },
  { "id": "self-cgroup", "command": "cat /proc/self/cgroup" },
  { "id": "memory-limit", "command": "python3 -I -c \"b = bytearray(600*1024*1024); b[::4096] = b'x' * len(b[::4096]); print('allocated')\"; echo code=$?", "timeout_ms": 30000 },
  { "id": "after-oom", "command": "echo shell-alive" },
  { "id": "pids-limit", "command": "python3 -I -c \"\nimport os, time\nn = 0\ntry:\n    while n < 400:\n        if os.fork() == 0:\n            time.sleep(2); os._exit(0)\n        n += 1\nexcept OSError as e:\n    print('forked', n, 'then errno', e.errno)\nwhile True:\n    try: os.wait()\n    except ChildProcessError: break\"", "timeout_ms": 30000 },
  { "id": "tmp-limit", "command": "head -c 300M /dev/zero > /tmp/big; echo code=$?; du -m /tmp/big | cut -f1; rm /tmp/big", "timeout_ms": 30000 },
  { "id": "python-libs", "command": "python3 -c \"import numpy, PIL; print(numpy.__version__, PIL.__version__)\"" },
  { "id": "tools", "command": "jq --version; rg --version | head -1; convert -version | head -1 | cut -d' ' -f1-3; file --version | head -1" },
  { "id": "jq", "command": "echo '{\"a\":[1,2]}' | jq -c .a" },
  { "id": "env", "command": "env | grep -v '^HOSTNAME=' | grep -v '^_=' | sort" },
  { "id": "home-path", "command": "echo \"$HOME|$PATH|$LANG|$SHLVL|$-|$0\"" },
  { "id": "umask", "command": "umask" },
  { "id": "init", "command": "cat /proc/1/cmdline | tr '\\0' ' '; echo" },
  { "id": "nproc", "command": "nproc" },
  { "id": "caps", "command": "grep -E '^(CapInh|CapPrm|CapEff|CapBnd|CapAmb|NoNewPrivs)' /proc/self/status" },
  { "id": "seccomp", "command": "grep -E '^Seccomp' /proc/self/status" },
  { "id": "unshare", "command": "unshare -U true 2>&1; echo code=$?" },
  { "id": "su", "command": "su -c true 2>&1 </dev/null | head -1; echo code=$?" },
  { "id": "ulimit-n", "command": "ulimit -n" },
  { "id": "tty", "command": "tty; echo code=$?" },
  { "id": "no-network-curl", "command": "curl -sS -m 3 http://example.com 2>&1; echo code=$?" },
  { "id": "no-network-socket", "command": "python3 -c \"import socket; socket.create_connection(('1.1.1.1', 443), 3)\" 2>&1 | tail -1" },
  { "id": "heredoc", "command": "cat <<'EOF'\nline one\n  indented $NOT_EXPANDED\nEOF" },
  { "id": "big-command", "command": "python3 - <<'EOF'\nprint(len('''REPLACED_BY_BIG'''))\nEOF" },
  { "id": "stdin-read", "command": "read -t 1 x; echo read=$?", "timeout_ms": 3000 },
  { "id": "proc-count", "command": "ls -d /proc/[0-9]* | wc -l" },
  { "id": "mount-tmp-noexec", "command": "printf '#!/bin/sh\\necho ran\\n' > /tmp/s.sh; chmod +x /tmp/s.sh; /tmp/s.sh 2>&1; echo code=$?" },
  { "id": "net-https", "command": "curl -sS -m 10 -o /dev/null -w '%{http_code}\\n' https://example.com/", "network": true },
  { "id": "net-dns", "command": "getent hosts example.com > /dev/null; echo code=$?", "network": true },
  { "id": "net-refused-lan", "command": "curl -sS -m 3 http://192.168.0.1/ 2>&1; echo code=$?", "network": true },
  { "id": "net-refused-metadata", "command": "curl -sS -m 3 http://169.254.169.254/ 2>&1; echo code=$?", "network": true },
  { "id": "net-refused-udp", "command": "python3 -I -c \"\nimport socket\ns = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.connect(('192.168.0.1', 53))\ntry: s.send(b'x')\nexcept Exception as e: print(type(e).__name__, e)\"", "network": true },
  { "id": "net-ipv6", "command": "cat /proc/sys/net/ipv6/conf/all/disable_ipv6 /proc/sys/net/ipv6/conf/default/disable_ipv6; wc -l < /proc/net/if_inet6", "network": true },
  { "id": "net-no-state", "command": "pwd; echo \"FOO=$FOO\"", "network": true },
  { "id": "net-bg", "command": "(sleep 2; touch net-bg) & echo launched", "network": true },
  { "id": "net-bg-gone", "command": "sleep 3; ls net-bg 2>&1; echo code=$?" },
  { "id": "net-timeout", "command": "echo net-before; sleep 5", "timeout_ms": 1000, "network": true },
  { "id": "net-exit-code", "command": "exit 4", "network": true },
  { "id": "net-work-shared", "command": "cat b.txt", "network": true },
  { "id": "net-stderr", "command": "echo out; echo err >&2", "network": true },
  { "id": "tight-fill", "chat": "tight", "command": "dd if=/dev/zero of=big.bin bs=1M count=2 2>&1 | tail -1" },
  { "id": "tight-refused", "chat": "tight", "measure": true, "command": "echo hello > note.txt; python3 -c \"open('py.txt','w').write('x')\" 2>&1 | tail -1; ls" },
  { "id": "tight-freed", "chat": "tight", "command": "rm big.bin && echo freed" },
  { "id": "tight-normal", "chat": "tight", "command": "echo hello > note.txt && cat note.txt" },
  { "id": "make-png", "command": "python3 -c \"from PIL import Image; Image.new('RGB', (2000, 1000), (10, 200, 30)).save('img.png')\" && ls img.png" },
  { "id": "view-png", "op": "view_image", "path": "img.png" },
  { "id": "view-missing", "op": "view_image", "path": "missing.png" },
  { "id": "view-not-image", "op": "view_image", "path": "b.txt" },
  { "id": "view-escape", "op": "view_image", "path": "../x.png" },
  { "id": "remove", "op": "remove", "paths": ["b.txt", "nothing"] },
  { "id": "after-remove", "command": "ls b.txt 2>&1; echo code=$?" },
  { "id": "disable-network", "op": "disable_network" },
  { "id": "net-disabled", "command": "echo should-not-run", "network": true }
]
