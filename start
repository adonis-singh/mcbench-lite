#!/usr/bin/env bash
# Starts mcbench-lite: ./start, or ./start --no-open to open no browser.
#
# It checks what only you can install (the Xcode Command Line Tools on a
# Mac; cc, python3, curl, xz, bubblewrap and prlimit on Linux) and, on
# Linux, that bubblewrap can make its sandbox, downloads the app's own
# Node.js into the tools folder (MCBENCH_TOOLS_DIR, default
# ~/.mcbench-lite/tools) and checks it against the checksum written here,
# runs `npm ci` when package-lock.json changed since the last install, then
# runs the server in the foreground and opens its access link in the
# default browser once it answers. Every other argument and the whole
# environment (PORT, MCBENCH_DATA_DIR, ...) go to the server.
#
# For the tests only: MCBENCH_NODE_DIST is the address Node.js is
# downloaded from, MCBENCH_NODE_SHA256 the checksum it must have, and
# MCBENCH_SYSTEM_ROOT the folder /usr/bin/bwrap, /usr/bin/prlimit and
# /proc/sys are looked for in.
set -euo pipefail

# --- prerequisites: the same in start and install.sh (test/start-script.test.js checks) ---

# The platform as Node.js names it: darwin or linux, arm64 or x64. Any other
# is refused.
detect_platform() {
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) os= ;;
  esac
  case "$(uname -m)" in
    arm64 | aarch64) arch=arm64 ;;
    x86_64 | amd64) arch=x64 ;;
    *) arch= ;;
  esac
  if [ -z "$os" ] || [ -z "$arch" ]; then
    echo "mcbench-lite runs on macOS and Linux, on arm64 or x64; this is $(uname -s) $(uname -m)." >&2
    exit 1
  fi
}

# What only the user can install. On macOS the Xcode Command Line Tools give
# cc, which rustc links with, git and python3. On Linux the server needs cc,
# python3 (the Claude Code and Codex CLI harnesses' MCP bridge),
# /usr/bin/bwrap and /usr/bin/prlimit (server/build-sandbox.js), and start
# needs curl and xz for the Node.js download. Each argument is one more
# command to require (install.sh requires git). Exits 1, saying what is
# missing and the command that installs it, when anything is.
check_prerequisites() {
  if [ "$os" = darwin ]; then
    if ! xcode-select -p > /dev/null 2>&1; then
      echo "mcbench-lite needs the Xcode Command Line Tools (they give cc, git and python3). Install them with:" >&2
      echo "  xcode-select --install" >&2
      echo "Then run this again." >&2
      exit 1
    fi
    return
  fi
  local system_root="${MCBENCH_SYSTEM_ROOT:-}" manager= sudo= missing= packages= item name package
  if command -v apt-get > /dev/null; then manager=apt-get
  elif command -v dnf > /dev/null; then manager=dnf
  elif command -v pacman > /dev/null; then manager=pacman
  fi
  [ "$EUID" -eq 0 ] || sudo='sudo '
  for item in cc python3 curl xz /usr/bin/bwrap /usr/bin/prlimit "$@"; do
    case "$item" in
      /*) [ -x "$system_root$item" ] && continue ;;
      *) command -v "$item" > /dev/null && continue ;;
    esac
    case "$item" in
      cc) name='a C compiler (cc)'; package=gcc; [ "$manager" = apt-get ] && package=build-essential ;;
      python3) name=python3; package=python3; [ "$manager" = pacman ] && package=python ;;
      xz) name=xz; package=xz; [ "$manager" = apt-get ] && package=xz-utils ;;
      /usr/bin/bwrap) name='bubblewrap (/usr/bin/bwrap)'; package=bubblewrap ;;
      /usr/bin/prlimit) name='prlimit (/usr/bin/prlimit, from util-linux)'; package=util-linux ;;
      *) name="$item"; package="$item" ;;
    esac
    missing="$missing${missing:+, }$name"
    packages="$packages${packages:+ }$package"
  done
  [ -z "$missing" ] && return
  echo "mcbench-lite needs these, which are not installed: $missing." >&2
  case "$manager" in
    apt-get) echo "Install them with:"$'\n'"  ${sudo}apt-get update && ${sudo}apt-get install -y $packages" >&2 ;;
    dnf) echo "Install them with:"$'\n'"  ${sudo}dnf install -y $packages" >&2 ;;
    pacman) echo "Install them with:"$'\n'"  ${sudo}pacman -S --needed $packages" >&2 ;;
    *) echo "Install them with your system's package manager (the packages are usually called: $packages)." >&2 ;;
  esac
  echo "Then run this again." >&2
  exit 1
}

# Build programs run under bubblewrap in their own user, PID, network, IPC,
# UTS and cgroup namespaces with a new /proc and /dev (server/build-sandbox.js).
# This runs `true` in such a sandbox; when bubblewrap cannot make it, exits 1
# with bubblewrap's message and, for each kernel setting known to forbid
# unprivileged user namespaces that is set so, the command that allows them.
check_sandbox() {
  [ "$os" = linux ] || return 0
  local system_root="${MCBENCH_SYSTEM_ROOT:-}" sudo= error
  error="$("$system_root/usr/bin/bwrap" --unshare-user --unshare-ipc --unshare-pid --unshare-net --unshare-uts --unshare-cgroup \
    --die-with-parent --ro-bind / / --proc /proc --dev /dev -- true 2>&1)" && return
  [ "$EUID" -eq 0 ] || sudo='sudo '
  echo "mcbench-lite runs build programs in a bubblewrap sandbox, which cannot be made here. bubblewrap says:" >&2
  echo "  $error" >&2
  # When the sysctl $1 is set to $2, says what that does ($5) and how to set
  # it to $3 for good, in /etc/sysctl.d/$4.
  remedy() {
    local file="$system_root/proc/sys/${1//.//}"
    [ -r "$file" ] && [ "$(< "$file")" = "$2" ] || return 0
    echo "$5 ($1=$2). To allow them from now on:" >&2
    echo "  echo $1=$3 | ${sudo}tee /etc/sysctl.d/$4 && ${sudo}sysctl -p /etc/sysctl.d/$4" >&2
  }
  # Ubuntu 24.04 and later: an unconfined program may make a user namespace
  # but has no capabilities in it. Lifting this applies to every program.
  remedy kernel.apparmor_restrict_unprivileged_userns 1 0 60-apparmor-namespace.conf 'AppArmor restricts unprivileged user namespaces'
  # Debian's own switch.
  remedy kernel.unprivileged_userns_clone 0 1 60-userns.conf 'The kernel forbids unprivileged user namespaces'
  remedy user.max_user_namespaces 0 1000 60-max-userns.conf 'The kernel allows no user namespaces'
  echo "Then run this again." >&2
  exit 1
}

# --- end of prerequisites ---

NODE_VERSION=26.13.1

# The sha256 of nodejs.org's node-v$NODE_VERSION-<platform>.tar.xz.
node_sha256() {
  case "$1" in
    darwin-arm64) echo af6202f5370a3a5209e85dc543758dfd9f44c8726626a236730cd603a67a8559 ;;
    darwin-x64) echo 2693310b2820f9350d29524f21344e1c623875bab773457d55b2aceb9670716f ;;
    linux-arm64) echo 89e1853138db51e8b82d3e98ba9c0d3f2956a28e5e55ea1b7e12d25aae92d5dd ;;
    linux-x64) echo 5c063e46bab0fbc1c17cc445d7ff129cbdcd0471be6ed83b6ab864f8143bc864 ;;
  esac
}

sha256_of() {
  if [ "$os" = darwin ]; then shasum -a 256 "$1" | cut -d ' ' -f 1
  else sha256sum "$1" | cut -d ' ' -f 1
  fi
}

# Downloads Node.js into $tools once, checked against its sha256 before it
# is unpacked. It is unpacked beside its final folder and moved there last,
# so a download that fails or is stopped leaves nothing that looks installed.
install_node() {
  local name="node-v$NODE_VERSION-$os-$arch"
  node_dir="$tools/$name"
  [ -x "$node_dir/bin/node" ] && return
  local expected="${MCBENCH_NODE_SHA256:-$(node_sha256 "$os-$arch")}"
  local url="${MCBENCH_NODE_DIST:-https://nodejs.org/dist}/v$NODE_VERSION/$name.tar.xz"
  echo "Downloading Node.js $NODE_VERSION (about 30 MB) into $tools"
  mkdir -p "$tools"
  work="$(mktemp -d "$tools/.download.XXXXXX")"
  trap 'rm -rf "$work"' EXIT
  curl --fail --silent --show-error --location --retry 3 --output "$work/node.tar.xz" "$url"
  local actual
  actual="$(sha256_of "$work/node.tar.xz")"
  if [ "$actual" != "$expected" ]; then
    echo "The download of $url has the sha256 $actual, not $expected: it is not the Node.js this start expects, so nothing was installed." >&2
    exit 1
  fi
  tar -xJf "$work/node.tar.xz" -C "$work"
  mv "$work/$name" "$node_dir"
  rm -rf "$work"
  trap - EXIT
}

# Runs `npm ci` when node_modules was not installed by this Node.js from
# this package-lock.json. The stamp in node_modules records both, and the
# sha256 of better-sqlite3's native module, which is built for one Node.js:
# `npm rebuild` with another Node.js changes it and leaves the stamp.
install_packages() {
  local stamp="$root/node_modules/.mcbench-start" native="$root/node_modules/better-sqlite3/build/Release/better_sqlite3.node" want
  want="node-v$NODE_VERSION-$os-$arch $(sha256_of "$root/package-lock.json")"
  [ -f "$stamp" ] && [ -f "$native" ] && [ "$(cat "$stamp")" = "$want $(sha256_of "$native")" ] && return
  echo "Installing the app's packages (npm ci)"
  (cd "$root" && npm ci --no-fund --no-audit --no-update-notifier --loglevel=error)
  echo "$want $(sha256_of "$native")" > "$stamp"
}

open=1
for arg in "$@"; do
  shift
  if [ "$arg" = --no-open ]; then open=0; else set -- "$@" "$arg"; fi
done

detect_platform
check_prerequisites
check_sandbox
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tools="${MCBENCH_TOOLS_DIR:-$HOME/.mcbench-lite/tools}"
install_node
# The server and every program it starts (npm, npx) use this Node.js.
export PATH="$node_dir/bin:$PATH"
install_packages

# The browser is opened by a process beside the server, which waits for the
# server to answer; exec keeps this pid ($$) for the server, so Ctrl-C stops
# it as it stops `npm start`.
if [ "$open" = 1 ]; then node "$root/scripts/open-browser.js" "$$" & fi
exec node "$root/server/index.js" "$@"
